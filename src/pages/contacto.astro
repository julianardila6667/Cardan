---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contacto"
  description="Contáctanos para cotizar tu servicio, agendar una visita o resolver cualquier duda. Estamos en Bogotá listos para atenderte."
>
  <PageHero
    eyebrow="Estamos para ayudarte"
    title="Hablemos sobre"
    highlight="tu cardán"
    description="Cotizaciones, diagnósticos, asesorías técnicas o atención por emergencia. Estos son nuestros canales para que nos contactes."
  />

  <section id="cotizar" class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <!-- Form -->
      <div class="rounded-3xl border border-divider bg-surface-2 p-8 md:p-10">
        <h2 class="h-display text-3xl text-body md:text-4xl">Envíanos un mensaje</h2>
        <p class="mt-3 text-muted">Completa el formulario y nuestro equipo te responde el mismo día hábil.</p>

        <form class="mt-8 grid gap-5 md:grid-cols-2" action="#" method="post" name="contacto">
          <div>
            <label class="text-xs font-semibold uppercase tracking-wider text-faint">Nombre</label>
            <input class="input mt-2" type="text" name="firstName" required placeholder="Tu nombre" />
          </div>
          <div>
            <label class="text-xs font-semibold uppercase tracking-wider text-faint">Apellido</label>
            <input class="input mt-2" type="text" name="lastName" placeholder="Tu apellido" />
          </div>
          <div>
            <label class="text-xs font-semibold uppercase tracking-wider text-faint">Correo</label>
            <input class="input mt-2" type="email" name="email" required placeholder="tucorreo@dominio.com" />
          </div>
          <div>
            <label class="text-xs font-semibold uppercase tracking-wider text-faint">Teléfono</label>
            <input class="input mt-2" type="tel" name="phone" placeholder="+57 300 000 0000" />
          </div>
          <div class="md:col-span-2">
            <label class="text-xs font-semibold uppercase tracking-wider text-faint">Tipo de servicio</label>
            <select class="input mt-2" name="service">
              <option>Venta de cardanes y repuestos</option>
              <option>Mantenimiento preventivo</option>
              <option>Adaptación / fabricación a la medida</option>
              <option>Diagnóstico técnico</option>
              <option>Servicio de emergencia</option>
              <option>Otro / consulta general</option>
            </select>
          </div>
          <div class="md:col-span-2">
            <label class="text-xs font-semibold uppercase tracking-wider text-faint">Mensaje</label>
            <textarea class="input mt-2 min-h-[140px] resize-y" name="message" placeholder="Cuéntanos brevemente qué necesitas (vehículo, falla, fecha aproximada...)"></textarea>
          </div>
          <div class="md:col-span-2 flex flex-wrap items-center justify-between gap-4">
            <label class="flex items-start gap-2 text-xs text-faint">
              <input type="checkbox" required class="mt-0.5 accent-accent-500" />
              Acepto que mis datos se utilicen para responder esta solicitud.
            </label>
            <button type="submit" class="btn-primary">
              Enviar mensaje <Icon name="arrow-right" class="h-4 w-4" />
            </button>
          </div>
        </form>
      </div>

      <!-- Contact info card -->
      <div class="space-y-5">
        <div class="rounded-3xl bg-accent-500 p-7 text-white">
          <h3 class="font-display text-xl font-semibold">Atención directa</h3>
          <p class="mt-2 text-sm text-white/85">¿Prefieres llamarnos? Estos son nuestros canales con respuesta inmediata.</p>
          <div class="mt-6 space-y-4 text-sm">
            <div class="flex items-start gap-3">
              <Icon name="phone" class="mt-0.5 h-5 w-5 shrink-0" />
              <div>
                {site.phones.map((p) => (
                  <a href={`tel:${p.replace(/\s/g, '')}`} class="block hover:underline">{p}</a>
                ))}
              </div>
            </div>
            <div class="flex items-start gap-3">
              <Icon name="mail" class="mt-0.5 h-5 w-5 shrink-0" />
              <a href={`mailto:${site.email}`} class="hover:underline">{site.email}</a>
            </div>
            <div class="flex items-start gap-3">
              <Icon name="whatsapp" class="mt-0.5 h-5 w-5 shrink-0" />
              <a href={site.social.whatsapp} target="_blank" rel="noopener" class="hover:underline">Escríbenos por WhatsApp</a>
            </div>
          </div>
        </div>

        <div class="rounded-3xl border border-divider bg-surface-2 p-7">
          <h3 class="font-display text-lg font-semibold text-body">Visítanos</h3>
          <div class="mt-4 space-y-4 text-sm">
            <div class="flex items-start gap-3">
              <Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" />
              <p class="text-soft">{site.address}</p>
            </div>
            <div class="flex items-start gap-3">
              <Icon name="clock" class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" />
              <div class="text-soft">
                {site.hours.map((h) => (
                  <p>
                    <span class="font-medium text-body">{h.day}:</span> {h.time}
                  </p>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="pb-20">
    <div class="container-x">
      <div class="overflow-hidden rounded-3xl border border-divider">
        <iframe
          title="Mapa Cardan y Repuestos"
          src="https://www.google.com/maps?q=Av+Carrera+30+%23+30A-87,+Bogot%C3%A1,+Colombia&output=embed"
          class="h-[420px] w-full md:h-[520px]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
