---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { posts } from '../../data/posts';
import { postImageBySlug } from '../../data/images';

const recent = posts.slice(0, 4);
const tags = Array.from(new Set(posts.flatMap((p) => p.tags)));
---

<BaseLayout
  title="Blog"
  description="Artículos, guías técnicas y consejos de mantenimiento sobre cardanes, transmisiones y maquinaria automotriz."
>
  <PageHero
    eyebrow="Blog y guías"
    title="Mantén tu vehículo al día con"
    highlight="contenido experto"
    description="Consejos prácticos, guías técnicas y novedades del mundo de los cardanes y las transmisiones."
  />

  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_320px]">
      <!-- Posts -->
      <div class="space-y-6">
        {posts.map((p) => (
          <article class="group overflow-hidden rounded-2xl border border-divider bg-surface-2 transition hover:border-divider-strong">
            <div class="grid md:grid-cols-[280px_1fr]">
              <a href={`/blog/${p.slug}`} class="relative block aspect-[4/3] overflow-hidden md:aspect-auto">
                <img src={postImageBySlug[p.slug]?.src} alt={postImageBySlug[p.slug]?.alt ?? p.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" width="560" height="420" />
                <div class="absolute inset-0 bg-gradient-to-t from-ink-950/30 to-transparent"></div>
                <div class="absolute left-4 top-4 rounded-full bg-accent-500 px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-white shadow-lg">{p.category}</div>
              </a>
              <div class="flex flex-col p-7">
                <div class="text-xs text-faint">{p.date} · {p.readTime} de lectura</div>
                <h3 class="mt-3 font-display text-xl font-semibold text-body transition group-hover:text-accent-400 md:text-2xl">
                  <a href={`/blog/${p.slug}`}>{p.title}</a>
                </h3>
                <p class="mt-3 flex-1 text-sm text-muted md:text-base">{p.excerpt}</p>
                <a href={`/blog/${p.slug}`} class="mt-5 inline-flex items-center gap-2 self-start rounded-full bg-accent-500 px-4 py-2 text-xs font-semibold text-white transition hover:bg-accent-600">
                  Leer más <Icon name="arrow-right" class="h-3.5 w-3.5" />
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6 lg:sticky lg:top-32 lg:self-start">
        <!-- Search -->
        <div class="rounded-2xl border border-divider bg-surface-2 p-6">
          <label class="text-xs font-semibold uppercase tracking-wider text-faint">Buscar</label>
          <div class="mt-3 flex items-center gap-2 rounded-xl border border-divider bg-page px-3">
            <svg viewBox="0 0 24 24" class="h-4 w-4 text-faint" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
            <input type="text" placeholder="Buscar artículo..." class="w-full bg-transparent py-3 text-sm text-body placeholder:text-faint focus:outline-none" />
          </div>
        </div>

        <!-- Recent posts -->
        <div class="rounded-2xl border border-divider bg-surface-2 p-6">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-faint">Artículos recientes</h4>
          <ul class="mt-4 space-y-4">
            {recent.map((r) => (
              <li>
                <a href={`/blog/${r.slug}`} class="block transition hover:opacity-80">
                  <p class="text-xs text-faint">{r.date}</p>
                  <p class="mt-1 text-sm font-medium text-body line-clamp-2">{r.title}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Tags -->
        <div class="rounded-2xl border border-divider bg-surface-2 p-6">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-faint">Etiquetas</h4>
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((t) => (
              <span class="rounded-full border border-divider bg-surface-2 px-3 py-1 text-xs text-soft transition hover:border-accent-500/40 hover:text-body">{t}</span>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>

</BaseLayout>
