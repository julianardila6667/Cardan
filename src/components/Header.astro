---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50">
  <!-- Top utility bar -->
  <div class="hidden border-b border-divider bg-page/90 backdrop-blur-md md:block">
    <div class="container-x flex h-10 items-center justify-between text-xs text-muted">
      <div class="flex items-center gap-6">
        <span class="inline-flex items-center gap-2">
          <Icon name="pin" class="h-3.5 w-3.5 text-accent-500" />
          {site.address}
        </span>
        <span class="inline-flex items-center gap-2">
          <Icon name="clock" class="h-3.5 w-3.5 text-accent-500" />
          L–V 8:00 a.m. – 5:00 p.m. · Sáb 8:00 a.m. – 1:00 p.m.
        </span>
      </div>
      <div class="flex items-center gap-5">
        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 hover:text-body">
          <Icon name="mail" class="h-3.5 w-3.5" />
          {site.email}
        </a>
        <a href={`tel:${site.phones[0].replace(/\s/g, '')}`} class="inline-flex items-center gap-2 hover:text-body">
          <Icon name="phone" class="h-3.5 w-3.5" />
          {site.phones[0]}
        </a>
      </div>
    </div>
  </div>

  <!-- Main nav -->
  <div class="border-b border-divider bg-page/90 backdrop-blur-md">
    <div class="container-x flex h-20 items-center justify-between gap-6">
      <Logo />

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'relative whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium transition-colors xl:px-4',
              isActive(item.href)
                ? 'text-body'
                : 'text-muted hover:text-body',
            ]}
          >
            {isActive(item.href) && (
              <span class="absolute inset-0 -z-10 rounded-full bg-surface-2 ring-1 ring-divider"></span>
            )}
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2 md:gap-3">
        <ThemeToggle class="hidden sm:inline-flex" />

        <a
          href={site.social.whatsapp}
          target="_blank"
          rel="noopener"
          class="hidden xl:inline-flex btn-ghost"
        >
          <Icon name="whatsapp" class="h-4 w-4 text-emerald-500" />
          WhatsApp
        </a>
        <a
          href="/contacto#cotizar"
          class="hidden sm:inline-flex btn-primary whitespace-nowrap"
        >
          <span class="hidden md:inline">Cotizar servicio</span>
          <span class="md:hidden">Cotizar</span>
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>

        <button
          id="mobile-menu-button"
          class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-divider-strong/60 bg-surface-2 text-body lg:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" class="h-5 w-5" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-[60] hidden bg-page/95 backdrop-blur-md lg:hidden"
    role="dialog"
    aria-modal="true"
  >
    <div class="container-x flex h-20 items-center justify-between">
      <Logo />
      <button
        id="mobile-menu-close"
        class="grid h-10 w-10 place-items-center rounded-full border border-divider-strong/60 bg-surface-2 text-body"
        aria-label="Cerrar menú"
      >
        <Icon name="close" class="h-5 w-5" />
      </button>
    </div>
    <nav class="container-x flex flex-col gap-2 pt-4" aria-label="Navegación móvil">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'flex items-center justify-between rounded-2xl border px-5 py-4 text-base font-medium transition-colors',
            isActive(item.href)
              ? 'border-accent-500/40 bg-accent-500/10 text-body'
              : 'border-divider bg-surface text-soft hover:bg-surface-2',
          ]}
        >
          {item.label}
          <Icon name="chevron-right" class="h-4 w-4 opacity-60" />
        </a>
      ))}
      <div class="mt-6 flex flex-col gap-3">
        <ThemeToggle class="self-center" />
        <a href="/contacto#cotizar" class="btn-primary w-full">Cotizar servicio</a>
        <a href={site.social.whatsapp} target="_blank" rel="noopener" class="btn-ghost w-full">
          <Icon name="whatsapp" class="h-4 w-4 text-emerald-500" />
          Escríbenos por WhatsApp
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const close = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');

  const open = () => {
    menu?.classList.remove('hidden');
    btn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const hide = () => {
    menu?.classList.add('hidden');
    btn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  btn?.addEventListener('click', open);
  close?.addEventListener('click', hide);
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', hide));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && hide());
</script>
