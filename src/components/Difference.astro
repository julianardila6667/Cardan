---
import Icon from './Icon.astro';
import { img } from '../data/images';

const points = [
  'Más de 40 años de experiencia comprobada',
  'Garantía real en cada trabajo realizado',
  'Diagnóstico técnico profesional sin costo',
  'Repuestos originales y reconstruidos certificados',
  'Atención personalizada y asesoría continua',
  'Cobertura para vehículos, industria y agro',
];
---

<section class="section bg-page">
  <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <!-- Visual -->
    <div class="relative">
      <div class="relative aspect-square w-full overflow-hidden rounded-3xl border border-divider">
        <img src={img.gears} alt={img.gearsAlt} class="h-full w-full object-cover" loading="lazy" width="800" height="800" />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-950/60 via-ink-950/20 to-transparent"></div>

        <!-- +15K stat overlay -->
        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 grid h-[180px] w-[180px] place-items-center rounded-full border border-white/30 bg-accent-500/85 backdrop-blur-sm shadow-2xl">
          <div class="text-center">
            <span class="block font-display text-5xl font-bold leading-none text-white">+15K</span>
            <span class="mt-1 block text-[10px] font-semibold uppercase tracking-widest text-white/85">Cardanes</span>
          </div>
        </div>

        <!-- Floating chip -->
        <div class="absolute right-5 top-5 rounded-full bg-accent-500 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white shadow-lg">
          Cardanes fabricados
        </div>
      </div>

      <!-- Decorative red badge -->
      <div class="absolute -bottom-6 -right-4 hidden rounded-2xl border border-divider bg-accent-500 p-5 text-white shadow-2xl md:block">
        <p class="text-[10px] font-semibold uppercase tracking-widest text-white/80">Desde</p>
        <p class="font-display text-3xl font-bold text-white">1980</p>
        <p class="text-xs text-white/85">en operación</p>
      </div>
    </div>

    <!-- Copy -->
    <div>
      <p class="eyebrow">La diferencia Cardan y Repuestos</p>
      <h2 class="mt-4 h-display text-4xl md:text-5xl">
        Por qué somos el <span class="text-accent-500">aliado</span> que tu industria necesita
      </h2>
      <p class="mt-5 max-w-xl text-muted">
        No solo vendemos cardanes: somos el equipo que los conoce a fondo. Cada servicio se respalda con experiencia, repuestos certificados y un compromiso real de calidad.
      </p>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {points.map((p) => (
          <li class="flex items-start gap-3 text-sm text-soft">
            <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-accent-500 text-white">
              <Icon name="check" class="h-3 w-3" />
            </span>
            {p}
          </li>
        ))}
      </ul>

      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/nosotros" class="btn-primary">Conoce más <Icon name="arrow-right" class="h-4 w-4" /></a>
        <a href="/productos-servicios" class="btn-ghost">Ver servicios</a>
      </div>
    </div>
  </div>
</section>
