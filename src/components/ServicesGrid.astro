---
import Icon from './Icon.astro';

interface ServiceItem {
  title: string;
  description: string;
  icon: 'cog' | 'wrench' | 'gear' | 'headset' | 'shield' | 'truck' | 'tractor' | 'industry';
  href?: string;
}

interface Props {
  services: ServiceItem[];
  showCta?: boolean;
  ctaLabel?: string;
}

const { services, showCta = true, ctaLabel = 'Solicitar' } = Astro.props;
---

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
  {services.map((s) => (
    <article class="group relative flex flex-col rounded-2xl border border-divider bg-surface-2 p-7 transition hover:border-accent-500/40 hover:bg-surface-soft">
      <div class="mb-6 grid h-14 w-14 place-items-center rounded-xl bg-accent-500/15 text-accent-500 ring-1 ring-accent-500/30 transition group-hover:bg-accent-500 group-hover:text-white">
        <Icon name={s.icon} class="h-7 w-7" />
      </div>
      <h3 class="font-display text-xl font-semibold text-body">{s.title}</h3>
      <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{s.description}</p>
      {showCta && (
        <a href={s.href ?? '/contacto#cotizar'} class="btn-primary mt-6 w-full justify-center">
          {ctaLabel}
        </a>
      )}
    </article>
  ))}
</div>
