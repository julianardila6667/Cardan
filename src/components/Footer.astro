---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, nav } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-divider bg-page">
  <div class="absolute inset-0 -z-10 bg-noise opacity-40"></div>
  <div class="absolute -top-40 left-1/2 -z-10 h-80 w-[80%] -translate-x-1/2 rounded-full bg-accent-500/10 blur-3xl"></div>

  <!-- CTA strip -->
  <div class="border-b border-divider">
    <div class="container-x grid gap-8 py-12 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <p class="eyebrow">¿Tu cardán necesita atención?</p>
        <h3 class="mt-3 h-display text-3xl md:text-4xl">Diagnóstico gratuito y cotización <span class="text-accent-500">en menos de 24 horas</span></h3>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/contacto#cotizar" class="btn-primary">Solicitar cotización <Icon name="arrow-right" class="h-4 w-4" /></a>
        <a href={site.social.whatsapp} target="_blank" rel="noopener" class="btn-ghost">
          <Icon name="whatsapp" class="h-4 w-4 text-emerald-400" /> WhatsApp directo
        </a>
      </div>
    </div>
  </div>

  <!-- Main footer -->
  <div class="container-x grid gap-10 py-16 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <div class="space-y-5">
      <Logo />
      <p class="max-w-sm text-sm leading-relaxed text-muted">
        Especialistas en cardanes con más de 40 años respaldando a vehículos, maquinaria industrial y equipos agrícolas en Colombia.
      </p>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-[0.18em] text-body">Navegación</h4>
      <ul class="mt-5 space-y-3 text-sm">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="text-muted transition hover:text-body">{item.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-[0.18em] text-body">Servicios</h4>
      <ul class="mt-5 space-y-3 text-sm">
        <li><a href="/productos-servicios#venta" class="text-muted transition hover:text-body">Venta de cardanes</a></li>
        <li><a href="/productos-servicios#mantenimiento" class="text-muted transition hover:text-body">Mantenimiento</a></li>
        <li><a href="/productos-servicios#adaptacion" class="text-muted transition hover:text-body">Adaptación a la medida</a></li>
        <li><a href="/productos-servicios#asesoria" class="text-muted transition hover:text-body">Asesoría técnica</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-[0.18em] text-body">Contacto</h4>
      <ul class="mt-5 space-y-4 text-sm">
        <li class="flex items-start gap-3">
          <Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" />
          <span class="text-muted">{site.address}</span>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" />
          <span class="flex flex-col gap-1 text-muted">
            {site.phones.map((p) => (
              <a href={`tel:${p.replace(/\s/g, '')}`} class="hover:text-body">{p}</a>
            ))}
          </span>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="mail" class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" />
          <a href={`mailto:${site.email}`} class="text-muted hover:text-body">{site.email}</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-divider">
    <div class="container-x flex flex-col items-start justify-between gap-3 py-6 text-xs text-faint md:flex-row md:items-center">
      <p>© {year} {site.name}. Todos los derechos reservados.</p>
      <p>Diseño hecho con cuidado por el equipo de Cardan y Repuestos.</p>
    </div>
  </div>
</footer>

<a
  href={site.social.whatsapp}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
  class="fixed bottom-5 right-5 z-40 grid h-14 w-14 place-items-center rounded-full bg-emerald-500 text-white shadow-[0_10px_30px_-10px_rgba(16,185,129,.7)] ring-4 ring-emerald-500/20 transition hover:scale-105 hover:bg-emerald-400"
>
  <Icon name="whatsapp" class="h-7 w-7" />
</a>
