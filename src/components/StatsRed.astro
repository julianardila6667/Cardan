---
import { stats } from '../data/site';
---

<section class="bg-accent-500 text-white">
  <div class="container-x grid grid-cols-2 divide-x divide-white/25 py-10 md:grid-cols-4 md:py-12">
    {stats.map((s) => (
      <div class="px-4 py-2 text-center md:px-8">
        <div class="font-display text-4xl font-bold leading-none md:text-5xl">{s.value}</div>
        <div class="mt-2 text-[11px] font-medium uppercase tracking-[0.18em] text-white/85 md:text-xs">{s.label}</div>
      </div>
    ))}
  </div>
</section>
