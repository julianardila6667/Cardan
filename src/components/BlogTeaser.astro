---
import Icon from './Icon.astro';
import { posts } from '../data/posts';
import { postImageBySlug } from '../data/images';

const teaser = posts.slice(0, 3);
---

<section class="section">
  <div class="container-x">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow">Blog y noticias</p>
        <h2 class="mt-4 h-display text-4xl md:text-5xl">
          Mantén tu cardán al <span class="text-accent-500">día</span>
        </h2>
        <p class="mt-4 text-muted">Consejos, guías técnicas y novedades del mundo de las transmisiones, cardanes y mantenimiento automotriz.</p>
      </div>
      <a href="/blog" class="btn-ghost">Ver todos los artículos <Icon name="arrow-right" class="h-4 w-4" /></a>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {teaser.map((p) => (
        <article class="group flex flex-col overflow-hidden rounded-2xl border border-divider bg-surface-2 transition hover:border-divider-strong">
          <a href={`/blog/${p.slug}`} class="relative block aspect-[16/10] overflow-hidden">
            <img src={postImageBySlug[p.slug]?.src} alt={postImageBySlug[p.slug]?.alt ?? p.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" width="600" height="375" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-950/30 to-transparent"></div>
            <div class="absolute left-4 top-4 rounded-full bg-accent-500 px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-white shadow-lg">{p.category}</div>
          </a>
          <div class="flex flex-1 flex-col p-6">
            <div class="text-xs text-faint">{p.date} · {p.readTime} de lectura</div>
            <h3 class="mt-3 font-display text-lg font-semibold text-body transition group-hover:text-accent-400">
              <a href={`/blog/${p.slug}`}>{p.title}</a>
            </h3>
            <p class="mt-2 line-clamp-3 flex-1 text-sm text-muted">{p.excerpt}</p>
            <a href={`/blog/${p.slug}`} class="mt-5 inline-flex items-center gap-2 self-start rounded-full bg-accent-500 px-4 py-2 text-xs font-semibold text-white transition hover:bg-accent-600">
              Leer más <Icon name="arrow-right" class="h-3.5 w-3.5" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
